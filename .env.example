# Copy to .env and change the secret. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes

# Optional (defaults shown)
# HTTP_PORT=8080
# GRPC_PORT=50051
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=user_management
# JWT_ISSUER=backend-test
# JWT_TTL=24h
# BCRYPT_COST=12
# USER_COUNT_INTERVAL=10s
# SHUTDOWN_TIMEOUT=15s
# LOG_FORMAT=text
